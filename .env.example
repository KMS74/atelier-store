# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard -> Connect).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-32+-character-random-string"
# Base URL of the app (used by the auth server).
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL (used by the auth client in the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
